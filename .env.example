# ============================================================
# Fire Intelligence Core
# Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=fire-intelligence-core
APP_ENV=development
APP_VERSION=0.1.0

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO


# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Replace this in the real deployment environment.
# NEVER commit the real value to Git.
API_KEY=change-me-in-production


# ------------------------------------------------------------
# Incident Engine
# ------------------------------------------------------------

INCIDENT_ACTIVATION_THRESHOLD=0.75
INCIDENT_CONFIRMATION_THRESHOLD=0.80
INCIDENT_ESCALATION_THRESHOLD=0.85

INCIDENT_COOLDOWN_SECONDS=30

INCIDENT_MAX_ACTIVE_PER_CAMERA=1


# ------------------------------------------------------------
# Temporal Processing
# ------------------------------------------------------------

TEMPORAL_EMA_ALPHA=0.35

TEMPORAL_ACTIVATION_THRESHOLD=0.75
TEMPORAL_DEACTIVATION_THRESHOLD=0.60

TEMPORAL_MIN_PERSISTENCE_FRAMES=3
TEMPORAL_MAX_TRACK_AGE=30


# ------------------------------------------------------------
# Risk Engine
# ------------------------------------------------------------

RISK_CONFIDENCE_WEIGHT=0.60
RISK_SPATIAL_WEIGHT=0.40

RISK_MAX_SCORE=100.0


# ------------------------------------------------------------
# Camera / Edge
# ------------------------------------------------------------

CAMERA_FRAME_WIDTH=1280
CAMERA_FRAME_HEIGHT=720

CAMERA_FPS=15

RTSP_CONNECT_TIMEOUT_SECONDS=10
RTSP_READ_TIMEOUT_SECONDS=5


# ------------------------------------------------------------
# Alerting
# ------------------------------------------------------------

ALERT_REQUEST_TIMEOUT_SECONDS=10

ALERT_MAX_RETRIES=3

ALERT_RETRY_BASE_DELAY_SECONDS=1


# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------

TELEGRAM_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ------------------------------------------------------------
# WhatsApp Cloud API
# ------------------------------------------------------------

WHATSAPP_ENABLED=false

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=


# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------

METRICS_ENABLED=true

METRICS_PORT=9090

OTEL_ENABLED=false

OTEL_SERVICE_NAME=fire-intelligence-core

OTEL_EXPORTER_OTLP_ENDPOINT=


# ------------------------------------------------------------
# Database
# Reserved for persistent incident/event storage.
# ------------------------------------------------------------

DATABASE_URL=


# ------------------------------------------------------------
# Redis
# Reserved for distributed state/cache.
# ------------------------------------------------------------

REDIS_URL=